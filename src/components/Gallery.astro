---
interface Props {
  images: string[];
  name: string;
  location?: string;
  /** Flag histórico por tienda (`galleryFeatured` en stores.json). */
  featured?: boolean;
  /** Variante que pide la plantilla. 'destacada' equivale al flag anterior. */
  variant?: string;
}
const { images, name, location = '', featured = false, variant } = Astro.props;
// La variante de la plantilla y el flag por tienda son la misma decisión
// expresada de dos formas; cualquiera de las dos activa el layout destacado.
const esDestacada = variant === 'destacada' || featured;
const altSuffix = location ? ` en ${location}` : '';
---

<section class="gallery section">
  <div class="container">
    <h2 class="section-title">Conoce nuestra tienda y equipo</h2>
    <div class={`gallery-grid${esDestacada ? ' gallery-grid--featured' : ''}`}>
      {images.map((src, i) => (
        <div class="gallery-item">
          <img
            src={src}
            alt={`${name} - tienda de nutrición deportiva y suplementos${altSuffix} (foto ${i + 1})`}
            loading="lazy"
            width="400"
            height="300"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--color-bg-alt);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .gallery-grid--featured {
    grid-template-columns: repeat(3, 1fr);
  }

  .gallery-grid--featured .gallery-item:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .gallery-item {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-media);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
