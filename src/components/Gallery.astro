---
import { planDeGaleria, type PlanDeGaleria } from '@/data/galeria';
import { srcsetDe, sizesDeFoto } from '@/data/imagen';

interface Props {
  /** Plan ya calculado por `galeriaDe(tienda)`. */
  plan: PlanDeGaleria;
  name: string;
  location?: string;
  /**
   * Variante que pide la plantilla. `'destacada'` sube la primera foto a todo
   * el ancho, igual que el flag `galleryFeatured` de la tienda.
   *
   * Se perdió al reescribir este componente y no lo notó nadie: **ninguna
   * tienda usa plantilla todavía**, así que la única forma de llegar aquí era
   * mirar la plantilla `angular` a propósito. Es exactamente el fallo que una
   * funcionalidad sin adoptantes esconde durante meses.
   */
  variant?: string;
}
const { plan: planRecibido, name, location = '', variant } = Astro.props;

// La variante de la plantilla y el flag por tienda son la misma decisión
// expresada de dos formas; cualquiera de las dos destaca la primera foto.
//
// Antes esto se resolvía aquí con un `column-span: all` sobre la primera foto,
// porque la variante llega al componente y el plan se calcula antes, en el
// registro. Con filas justificadas ya no vale: destacar es *estar en una fila
// propia*, y eso es una decisión de reparto, no un estilo que se pueda poner
// encima. Así que si la variante lo pide y el plan no lo trae, se recalcula.
// Es barato —aritmética sobre cinco números— y deja UN solo mecanismo de
// maquetación en vez de dos conviviendo.
//
// `planDeGaleria` mantiene la guarda física: una vertical a 900px de ancho
// mediría 1200px de alto, así que solo se destaca una apaisada.
const plan: PlanDeGaleria =
  variant === 'destacada' && !planRecibido.destacarPrimera
    ? planDeGaleria(planRecibido.fotos, { destacadaForzada: true })
    : planRecibido;

// El número de foto del texto alternativo cuenta sobre la galería entera, no
// sobre su fila: para quien lo escucha, «foto 4 de 5» es una sola secuencia.
const numeroDe = new Map(plan.fotos.map((f, i) => [f.src, i + 1]));
const altSuffix = location ? ` en ${location}` : '';
---

{/*
  LA GALERÍA NO RECORTA NINGUNA FOTO.

  Antes: grid de 2 columnas con `aspect-ratio: 4/3` y `object-fit: cover`. A las
  tres fotos verticales de Lagoh (382×510) les comía el 44% del alto y encima
  las ampliaba de 382 a 442 px. Y como eran 3 en un grid de 2, la tercera
  quedaba huérfana.

  El primer arreglo fue elegir UNA forma de celda por tienda según la
  orientación mayoritaria. Al medir las 52 fotos reales resultó insuficiente:
  4 de las 8 tiendas MEZCLAN orientaciones, y villanueva y marineda lo hacen
  exactamente a la mitad (3 y 3). Con una sola forma de celda se recorta la
  mitad de las fotos igual; solo cambia cuáles.

  Por eso ahora cada foto lleva SU proporción y el flujo es multicolumna:

    · nada se recorta, sea cual sea la mezcla
    · los números impares dejan de dejar huecos por construcción — en un flujo
      multicolumna no hay filas fijas donde pueda faltar algo
    · `width`/`height` reales por foto, así que el navegador reserva el hueco
      exacto y no hay saltos de maquetación (antes iban 400×300 a pelo en TODAS)

  Lo único que decide `galeria.ts` es cuántas columnas, y basta una foto
  vertical para pasar a 3: a 2 columnas la celda mide 442 px, así que una 9:16
  —las de Vigo— saldría de 786 px de alto y se comería la pantalla.
*/}
<section class="gallery section">
  <div class="container">
    <h2 class="section-title">Conoce nuestra tienda y equipo</h2>
    <div class="gallery-grid" style={`--ancho-maximo:${plan.anchoMaximo}px`}>
      {plan.filas.map((fila) => (
        <div
          class:list={['gallery-fila', { 'gallery-fila--centrada': fila.centrada }]}
          style={`--tope:${fila.tope}px`}
        >
          {fila.fotos.map((foto) => (
            <figure
              class="gallery-item"
              style={`--proporcion:${foto.proporcion};--ratio:${foto.ratio.toFixed(4)}`}
            >
              <img
                src={foto.src}
                srcset={srcsetDe(foto)}
                sizes={sizesDeFoto(foto.parte)}
                alt={`${name} - tienda de nutrición deportiva y suplementos${altSuffix} (foto ${numeroDe.get(foto.src)})`}
                loading="lazy"
                decoding="async"
                width={foto.ancho}
                height={foto.alto}
              />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>


<style>
  .gallery {
    background: var(--color-bg-alt);
  }

  .gallery-grid {
    max-width: var(--ancho-maximo, 900px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* AQUÍ ESTÁ TODA LA MAQUETACIÓN, Y SON TRES LÍNEAS.
     Cada foto crece en proporción a su ratio sobre una base de 0, así que su
     ancho es (ancho útil · ratio / Σratios) y su alto, por la proporción, sale
     (ancho útil / Σratios): IGUAL para todas las de la fila, sea cual sea su
     forma. La fila llena el ancho exacto a cualquier tamaño de pantalla, sin una
     sola altura en píxeles y sin JavaScript. */
  .gallery-fila {
    display: flex;
    gap: 1rem;
  }

  .gallery-fila > .gallery-item {
    flex: var(--ratio, 1) 1 0;
    min-width: 0;
  }

  /* La fila que llenaría el ancho a costa de salir demasiado alta se queda a la
     altura del tope y se centra. Un margen simétrico se lee como decisión; el
     mismo espacio a un lado, como un fallo de carga — que es lo que pasaba. */
  .gallery-fila--centrada {
    justify-content: center;
  }
  .gallery-fila--centrada > .gallery-item {
    flex-grow: 0;
    flex-basis: auto;
    height: var(--tope, 520px);
    width: auto;
  }
  .gallery-fila--centrada > .gallery-item img {
    width: auto;
    height: 100%;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-media);
    /* La proporción real de ESTA foto. El navegador reserva el hueco antes de
       descargarla, así que la página no da el salto al cargar. */
    aspect-ratio: var(--proporcion, 4 / 3);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    /* `cover` sigue aquí como red de seguridad por si `dimensiones.json` se
       quedara rancio: con la proporción correcta no recorta nada, porque la
       caja YA tiene la forma de la foto. */
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item img {
      transition: none;
    }
    .gallery-item:hover img {
      transform: none;
    }
  }

  /* En un móvil, una fila de tres verticales deja cada foto en 110px: se apilan.
     Cada una conserva su proporción, así que sigue sin recortarse nada. */
  @media (max-width: 640px) {
    .gallery-fila,
    .gallery-fila--centrada {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .gallery-fila > .gallery-item,
    .gallery-fila--centrada > .gallery-item {
      flex: none;
      width: 100%;
      height: auto;
    }
    .gallery-fila--centrada > .gallery-item img {
      width: 100%;
    }
  }
</style>
