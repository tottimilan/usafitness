---
import { LEGAL_DOCS } from '@/data/legal';

interface Props {
  name: string;
  slug: string;
  legalBase?: string;
}
const { name, slug, legalBase = `/${slug}` } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-legal" aria-label="Información legal">
      <span class="footer-legal-title">Información legal</span>
      <ul class="footer-legal-links">
        {LEGAL_DOCS.map((doc) => (
          <li>
            <a href={`${legalBase}/${doc.slug}`}>{doc.label}</a>
          </li>
        ))}
        <li>
          <button type="button" class="footer-cookie-btn" data-uf-cookie-config>Configurar cookies</button>
        </li>
      </ul>
    </nav>
    <p class="footer-copy">{name} &copy; {year} &mdash; Todos los derechos reservados</p>
  </div>
</footer>

<style>
  /* Botón de revocación de consentimiento. Se estiliza como un enlace más de
     la fila legal: es un requisito del art. 7.3 RGPD, no una acción destacada. */
  .footer-cookie-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
  }

  .footer {
    background: var(--color-primary);
    padding: 2.5rem 1.5rem 1.75rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .footer-legal-title {
    display: block;
    color: var(--color-on-brand);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
  }

  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .footer-legal-links a {
    font-size: 0.85rem;
    color: var(--color-on-brand-muted);
    transition: color 0.15s;
  }

  .footer-legal-links a:hover {
    color: var(--color-on-brand);
    text-decoration: underline;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--color-on-brand-faint);
    border-top: 1px solid var(--color-on-brand-divider);
    padding-top: 1.25rem;
    width: 100%;
    max-width: 600px;
  }
</style>
