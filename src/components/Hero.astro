---
import { srcsetDe } from '@/data/imagen';

interface Props {
  name: string;
  title: string;
  location: string;
  googleMapsLink?: string;
  /** Foto de cabecera con sus dimensiones reales, de `fotoHero(tienda)`. */
  hero: { src: string; ancho: number; alto: number };
  heroText?: string;
  /** Variante que pide la plantilla. 'compacto' = más bajo y alineado a la izquierda. */
  variant?: string;
}
const { name, title, location, googleMapsLink, hero, heroText, variant } = Astro.props;
const introText = heroText || `En ${name} encontrarás asesoramiento personalizado y la mejor nutrición deportiva al mejor precio en ${location}. Nuestros productos están seleccionados para ayudarte a alcanzar tus objetivos de fitness y bienestar.`;
---

<section class={`hero${variant ? ` hero--${variant}` : ''}`} id="inicio">
  <img
    class="hero-bg"
    src={hero.src}
    srcset={srcsetDe(hero)}
    sizes="100vw"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    width={hero.ancho}
    height={hero.alto}
  />
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-label">{name}</p>
    <h1 class="hero-title">{title}</h1>
    <p class="hero-text">{introText}</p>
    {/* Sin ficha de Google Business no hay adónde enlazar. Antes de agosto de
        2026 esto habría enlazado a una búsqueda —o peor, a la ficha del centro
        comercial, que es de otro negocio— así que el botón desaparece. */}
    {googleMapsLink && (
      <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary hero-cta">
        ¿Dónde Estamos?
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  /* Antes era un div con background-image fijo a /hero-bg.jpg: la misma foto en
     todas las tiendas, y descubierta tarde por el navegador porque vive en el CSS.
     Ahora es un <img> con la foto de CADA tienda y fetchpriority="high": es el
     elemento LCP y el navegador lo encuentra al parsear el HTML. */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
    padding: 3rem 1.5rem;
  }

  .hero-label {
    color: var(--color-primary-light);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-display);
    color: var(--color-primary);
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .hero-text {
    font-size: 1.05rem;
    color: var(--color-text);
    max-width: 600px;
    margin: 0 auto 2rem;
    font-style: italic;
    line-height: 1.7;
  }

  .hero-cta {
    font-size: 1.05rem;
    padding: 1rem 2.5rem;
  }

  /* --- Variante 'compacto' -------------------------------------------------
     Mismo componente, misma marca, otra presencia: menos alto, texto alineado
     a la izquierda y sin centrar. Es el tercer eje de diferenciación entre
     plantillas — que la misma sección se vea distinta. */
  .hero--compacto {
    min-height: 380px;
    justify-content: flex-start;
    text-align: left;
  }

  .hero--compacto .hero-content {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .hero--compacto .hero-text {
    margin-left: 0;
    margin-right: 0;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 420px;
    }

    .hero--compacto {
      min-height: 340px;
    }

    .hero-content {
      padding: 2rem 1rem;
    }
  }
</style>
