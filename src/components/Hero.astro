---
import { srcsetDe } from '@/data/imagen';
import { medirRotulo } from '@/data/rotulo';
import { estadoDeHoy } from '@/data/festivos';
import { textoDeHoy } from '@/data/hoy';

interface Props {
  name: string;
  title: string;
  location: string;
  googleMapsLink?: string;
  /** El cartel lleva los CTAs de contacto. Teléfono siempre; WhatsApp si existe. */
  phone?: string;
  whatsapp?: string;
  /** Foto de cabecera con sus dimensiones reales, de `fotoHero(tienda)`. */
  hero: { src: string; ancho: number; alto: number };
  heroText?: string;
  /** Variante que pide la plantilla. 'compacto' = más bajo y alineado a la izquierda. */
  variant?: string;
  /** Solo la variante `rotulo`: el cartel y la línea de dato. */
  rotulo?: string;
  schedule?: string;
  mall?: string;
}
const {
  name,
  title,
  location,
  googleMapsLink,
  hero,
  heroText,
  variant,
  phone = '',
  whatsapp,
  rotulo = '',
  schedule = '',
  mall = '',
} = Astro.props;
/**
 * EL CARTEL DE RÓTULO, medido en el servidor.
 *
 * 343 px es el ancho útil a 375: la pantalla menos el margen del plano. El
 * tamaño de letra sale de la tabla de avances de la fuente que se sirve, así que
 * no hay `vw` a ojo ni salto de maquetación cuando la fuente termina de cargar.
 * Ver `rotulo.ts` para por qué algunos se cortan por la derecha a propósito.
 */
const cartel = variant === 'rotulo' && rotulo ? medirRotulo(rotulo, 343) : null;
/** La línea de dato del cartel: lo que responde P1 sin bajar de la primera pantalla. */
const hoyEnCartel =
  variant === 'rotulo' && schedule ? textoDeHoy(estadoDeHoy({ schedule, mall }, new Date()), new Date()) : null;

const introText = heroText || `En ${name} encontrarás asesoramiento personalizado y la mejor nutrición deportiva al mejor precio en ${location}. Nuestros productos están seleccionados para ayudarte a alcanzar tus objetivos de fitness y bienestar.`;
---

{/* VARIANTE «cartel» (plantilla Energía): el primer viewport es un CARTEL
    tipográfico sobre azul de marca, no una foto velada. La ciudad gigante en
    condensada, el nombre en trazo hueco, y la foto en una ventana debajo con
    duotono suave. Diseñada para NO depender de la calidad de la foto — que es
    variable, la manda cada franquiciado.

    Los CTAs degradan: teléfono SIEMPRE (las 8 tiendas lo tienen), WhatsApp
    solo si existe — 3 de 8 no lo tienen, y prometer «dos botones siempre» fue
    la mentira que el panel de diseño cazó en los cinco conceptos a la vez. */}
{/* VARIANTE «rotulo»: el tipo ES la imagen. Lo primero que se ve no es una
    foto sino el nombre del sitio a escala de cartel, sobre un plano de color
    que llega al borde y acaba en diagonal.

    NO SE LLAMA «cartel» aunque lo sea: ese nombre de variante ya lo usa la
    plantilla Energía para otra cosa. Compartir nombre entre dos variantes que
    cambian el marcado es la mina que ya rompió la galería de energía una vez.

    QUÉ NO LLEVA, Y ESTÁ DECIDIDO: la línea de cifras del catálogo que pedía el
    diseño («PROTEÍNAS 199 · CREATINA 62 · MUJER 557»). Las tres son
    impublicables — las categorías del catálogo no son disjuntas y el 557 de
    «Mujer» resultó ser Control de Peso. Ver `puertas.ts`. */}
{variant === 'rotulo' ? (
  <section class="hero hero--rotulo" id="inicio">
    <div class="plano">
      <img src="/usafitness.svg" alt="USA Fitness" class="plano-logo" width="200" height="42" />

      <h1 class="plano-rotulo" style={`--rotulo-px:${cartel.px}px`}>
        {cartel.palabras.map((p) => (
          <span class="plano-palabra">{p}</span>
        ))}
      </h1>

      {/* R1: el primer viewport responde «¿está abierto?» y «¿dónde?» sin
          scroll, y en el mismo renglón. */}
      <p class="plano-dato">
        <b>{hoyEnCartel.titular.replace(/\.$/, '')}</b>
        {mall && <span class="plano-sep">·</span>}
        {mall && <span>{mall}</span>}
      </p>

      <div class="plano-acciones">
        {googleMapsLink ? (
          <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="plano-btn plano-btn--llena">Cómo llegar</a>
        ) : (
          <a href={`tel:${phone}`} class="plano-btn plano-btn--llena">Llámanos</a>
        )}
        {whatsapp ? (
          <a
            href={`https://wa.me/${whatsapp.replace('+', '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="plano-btn plano-btn--borde"
          >WhatsApp</a>
        ) : (
          googleMapsLink && <a href={`tel:${phone}`} class="plano-btn plano-btn--borde">Llamar</a>
        )}
      </div>
    </div>
  </section>
) : variant === 'cartel' ? (
  <section class="hero hero--cartel" id="inicio">
    <div class="cartel">
      <p class="cartel-eyebrow">Nutrición deportiva · Suplementación</p>
      <h1>
        <span class="cartel-ciudad">{location}</span>
        <span class="cartel-nombre">{name}</span>
      </h1>
      <p class="cartel-texto">{introText}</p>
      <div class="cartel-ctas">
        <a href={`tel:${phone}`} class="cartel-cta cartel-cta--llena">Llámanos</a>
        {whatsapp && (
          <a
            href={`https://wa.me/${whatsapp.replace('+', '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="cartel-cta cartel-cta--borde"
          >
            WhatsApp
          </a>
        )}
        {!whatsapp && googleMapsLink && (
          <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="cartel-cta cartel-cta--borde">
            Cómo llegar
          </a>
        )}
      </div>
      <div class="cartel-foto">
        <img
          src={hero.src}
          srcset={srcsetDe(hero)}
          sizes="100vw"
          alt=""
          aria-hidden="true"
          fetchpriority="high"
          decoding="async"
          width={hero.ancho}
          height={hero.alto}
        />
      </div>
    </div>
  </section>
) : (
<section class={`hero${variant ? ` hero--${variant}` : ''}`} id="inicio">
  <img
    class="hero-bg"
    src={hero.src}
    srcset={srcsetDe(hero)}
    sizes="100vw"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    width={hero.ancho}
    height={hero.alto}
  />
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-label">{name}</p>
    <h1 class="hero-title">{title}</h1>
    <p class="hero-text">{introText}</p>
    {/* Sin ficha de Google Business no hay adónde enlazar. Antes de agosto de
        2026 esto habría enlazado a una búsqueda —o peor, a la ficha del centro
        comercial, que es de otro negocio— así que el botón desaparece. */}
    {googleMapsLink && (
      <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary hero-cta">
        ¿Dónde Estamos?
      </a>
    )}
  </div>
</section>
)}

<style>
  .hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  /* Antes era un div con background-image fijo a /hero-bg.jpg: la misma foto en
     todas las tiendas, y descubierta tarde por el navegador porque vive en el CSS.
     Ahora es un <img> con la foto de CADA tienda y fetchpriority="high": es el
     elemento LCP y el navegador lo encuentra al parsear el HTML. */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
    padding: 3rem 1.5rem;
  }

  .hero-label {
    color: var(--color-primary-light);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-display);
    color: var(--color-primary);
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .hero-text {
    font-size: 1.05rem;
    color: var(--color-text);
    max-width: 600px;
    margin: 0 auto 2rem;
    font-style: italic;
    line-height: 1.7;
  }

  .hero-cta {
    font-size: 1.05rem;
    padding: 1rem 2.5rem;
  }

  /* --- Variante 'compacto' -------------------------------------------------
     Mismo componente, misma marca, otra presencia: menos alto, texto alineado
     a la izquierda y sin centrar. Es el tercer eje de diferenciación entre
     plantillas — que la misma sección se vea distinta. */
  .hero--compacto {
    min-height: 380px;
    justify-content: flex-start;
    text-align: left;
  }

  .hero--compacto .hero-content {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .hero--compacto .hero-text {
    margin-left: 0;
    margin-right: 0;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 420px;
    }

    .hero--compacto {
      min-height: 340px;
    }

    .hero-content {
      padding: 2rem 1rem;
    }
  }
</style>
