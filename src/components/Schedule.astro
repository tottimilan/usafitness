---
/**
 * VARIANTE `hoy` — «Hoy en tienda», la pieza que contesta P1
 *
 * La cara de siempre (dos tarjetas: horario completo y canales) se queda
 * intacta: ninguna de las ocho webs vivas declara plantilla y no puede cambiar.
 *
 * Qué hace la variante distinto, y por qué:
 *
 *  · **El dato de HOY manda.** El horario de la semana pasa a un `<details>`
 *    cerrado. Quien busca una tienda a las 20:40 no quiere una tabla de siete
 *    filas: quiere saber si llega. La tabla sigue ahí para quien la quiera.
 *  · **El minutero solo si se puede sostener** — ver la cabecera de `hoy.ts`.
 *  · **Se dice DÓNDE**, que es la otra mitad de P1. El nombre del centro y, si
 *    la dirección añade algo más, también: medido el 11-sep, lo que sigue al
 *    nombre del centro es una calle de verdad en 5 de las 8 tiendas.
 *  · **Los canales dejan de ser tarjetas** y pasan a una fila de acciones. Dos
 *    tarjetas con icono para dos enlaces es el patrón que el catálogo dio por
 *    pasado de moda.
 */
import { estadoDeHoy } from '@/data/festivos';
import { textoDeHoy, lineasDeSemana } from '@/data/hoy';

interface Props {
  schedule: string;
  phone: string;
  phoneDisplay: string;
  // Optional: a store may not have WhatsApp. When absent, that contact card is not rendered.
  whatsapp?: string;
  googleMapsLink?: string;
  name?: string;
  /** Solo los usa la variante `hoy`, para la mitad «dónde» de P1. */
  mall?: string;
  streetAddress?: string;
  variant?: string;
}
const {
  schedule,
  phone,
  phoneDisplay,
  whatsapp,
  googleMapsLink,
  name = '',
  mall = '',
  streetAddress = '',
  variant,
} = Astro.props;

const scheduleLines = schedule.split('\n');
const waNumber = whatsapp?.replace('+', '').trim() ?? '';

/** SSR en cada petición: el dato de hoy es de hoy, no del último despliegue. */
const hoy = variant === 'hoy' ? textoDeHoy(estadoDeHoy({ schedule, mall }, new Date()), new Date()) : null;
const semana = lineasDeSemana(schedule);
/** Lo que la dirección añade al nombre del centro, si añade algo. */
const restoDireccion =
  mall && streetAddress.startsWith(mall)
    ? streetAddress.slice(mall.length).replace(/^[,\s]+/, '')
    : streetAddress;
---

{variant === 'hoy' ? (
  <section class="schedule section" id="contacto">
    <div class="container hoy-inner">
      <h2 class="hoy-titulo">Hoy en tienda</h2>

      <p class="hoy-dato">{hoy.titular}</p>
      {hoy.minutero && <p class="hoy-minutero">{hoy.minutero}</p>}
      {hoy.pideLlamar && (
        <p class="hoy-aviso">No lo publicamos para hoy. Llámanos y te lo confirmamos antes de que te muevas.</p>
      )}

      {/* La semana entera, plegada. Con una sola línea no se pinta: sería un
          desplegable para enseñar lo que ya está justo encima. */}
      {semana.length > 1 && (
        <details class="hoy-semana">
          <summary>Toda la semana</summary>
          <ul>
            {semana.map((l) => (
              <li>{l}</li>
            ))}
          </ul>
        </details>
      )}

      <p class="hoy-donde">
        <span class="hoy-centro">{mall}</span>
        {restoDireccion && <span class="hoy-calle">{restoDireccion}</span>}
      </p>

      {/* El botón en su propia línea y los dos enlaces en la suya. En la primera
          vuelta iban los tres en la misma fila y el ancho de 375 partía justo
          por el medio: botón + «WhatsApp» arriba y «Llamar» suelto debajo, tres
          pesos a tres alturas. La acción principal manda sola; el contacto es
          una fila de texto. */}
      {googleMapsLink && (
        <p class="hoy-cta">
          <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Cómo llegar</a>
        </p>
      )}

      <div class="hoy-acciones">
        {waNumber && (
          <a
            href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Hola, os escribo desde vuestra web. ¿Estáis abiertos ahora?')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hoy-enlace"
          >WhatsApp</a>
        )}
        <a href={`tel:${phone}`} class="hoy-enlace">Llamar al {phoneDisplay}</a>
      </div>
    </div>
  </section>
) : (
<section class="schedule section" id="contacto">
  <div class="container">
    <h2 class="section-title">Horario y canales de contacto</h2>
    <div class="schedule-grid">
      <div class="schedule-card">
        <div class="card-header">
          <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="card-title">Horario de apertura</h3>
        </div>
        <div class="schedule-lines">
          {scheduleLines.map((line) => (
            <p class="schedule-line">{line}</p>
          ))}
        </div>
      </div>

      <div class="schedule-card">
        <div class="card-header">
          <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="card-title">Canales de contacto</h3>
        </div>
        <div class="contact-buttons">
          {waNumber && (
          <a href={`https://wa.me/${waNumber}?text=Hola%2C%20me%20interesa%20informaci%C3%B3n%20sobre%20${encodeURIComponent(name)}`} target="_blank" rel="noopener noreferrer" class="contact-link whatsapp-link">
            <span class="contact-icon-wrap whatsapp-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 0 0 .612.612l4.458-1.495A11.952 11.952 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.387 0-4.596-.838-6.32-2.234l-.44-.37-3.081 1.033 1.033-3.081-.37-.44A9.958 9.958 0 0 1 2 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
            </span>
            <span class="contact-text">
              <strong>WhatsApp</strong>
              <small>Escríbenos al instante</small>
            </span>
          </a>
          )}
          <a href={`tel:${phone}`} class="contact-link phone-link">
            <span class="contact-icon-wrap phone-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <span class="contact-text">
              <strong>Teléfono</strong>
              <small>{phoneDisplay}</small>
            </span>
          </a>
          {/* Sin ficha, sin enlace: ver el comentario de Hero.astro. */}
          {googleMapsLink && (
            <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="contact-link maps-link">
              <span class="contact-icon-wrap maps-bg">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span class="contact-text">
                <strong>Dónde estamos</strong>
                <small>Ver en Google Maps</small>
              </span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

)}

<style>
  .schedule {
    background: var(--color-bg-alt);
  }

  .schedule-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .schedule-card {
    background: var(--color-bg);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow-card);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-bg-alt);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-on-brand);
    flex-shrink: 0;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }

  .schedule-lines {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .schedule-line {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .schedule-line:last-child {
    border-bottom: none;
  }

  .contact-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .contact-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-pill);
  }

  .contact-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--color-on-brand);
    flex-shrink: 0;
  }

  .whatsapp-bg {
    background: var(--color-whatsapp);
  }

  .phone-bg {
    background: var(--color-cta);
  }

  .maps-bg {
    background: var(--color-primary);
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .contact-text strong {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .contact-text small {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  @media (max-width: 640px) {
    .schedule-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .schedule-card {
      padding: 1.5rem;
    }
  }
  /* ————— variante `hoy` ————— */

  .hoy-inner {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    align-items: flex-start;
  }

  /* Etiqueta, no titular: el dato de hoy es lo que tiene que mandar, y con un
     h2 a tamaño de sección competían los dos. Misma decisión que en «Por qué
     en tienda» y en la FAQ. */
  .hoy-titulo {
    margin: 0;
    font-size: 0.8rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  .hoy-dato {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.2;
    font-weight: var(--font-weight-heading);
    color: var(--color-primary);
    /* Cifras tabulares: «10:00 a 22:00» alinea con la tabla de la semana sin
       trucos, y en Android con Roboto la diferencia se nota. */
    font-variant-numeric: tabular-nums;
    text-wrap: balance;
  }

  .hoy-minutero {
    margin: 0;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .hoy-aviso {
    margin: 0;
    color: var(--color-text);
    line-height: 1.5;
    max-width: 46ch;
  }

  .hoy-semana {
    margin: 0.35rem 0 0;
    width: 100%;
  }

  .hoy-semana summary {
    cursor: pointer;
    color: var(--color-primary);
    font-weight: var(--font-weight-strong);
    font-size: 0.9rem;
  }

  .hoy-semana ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .hoy-semana li {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .hoy-donde {
    margin: 0.55rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hoy-centro {
    font-weight: var(--font-weight-strong);
    color: var(--color-text);
  }

  .hoy-calle {
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  .hoy-cta {
    margin: 0.8rem 0 0;
  }

  .hoy-acciones {
    margin-top: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.4rem;
  }

  .hoy-enlace {
    color: var(--color-cta);
    font-weight: var(--font-weight-strong);
    text-decoration: underline;
  }
</style>
