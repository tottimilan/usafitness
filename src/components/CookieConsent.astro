---
interface Props {
  ga4Id?: string;
  cookiePolicyHref: string;
}
const { ga4Id = '', cookiePolicyHref } = Astro.props;

// DOS DECISIONES INDEPENDIENTES, antes acopladas en una sola condición:
//   analitica  -> ¿hay algo que medir? (hoy solo GA4; mañana Pixel / Google Ads)
//   avisoCookies -> ¿hay que pedir consentimiento?
// Estaban unidas por `enabled = !!ga4Id`, así que una tienda sin ga4Id tampoco
// mostraba el aviso de cookies. Hoy eso no incumple —sin GA4 no se instala
// ninguna cookie— pero impide decidir cada cosa por separado y habría dejado
// las webs sin aviso el día que entre el Pixel de Meta.
const analitica = !!ga4Id;

// El aviso ya NO depende de que haya GA4. Antes sí, y era incoherente: el
// iframe de Google Maps y Google Fonts cargaban sin puerta, así que había
// terceros recibiendo la IP del visitante sin aviso posible.
//
// Ya no: las fuentes se sirven desde este dominio y el mapa es una fachada que
// solo carga Google si el usuario lo pide (Location.astro). Con eso, el aviso
// puede mostrarse siempre y RECHAZARLO IMPIDE ALGO DE VERDAD, que es lo único
// que lo hace honesto.
const avisoCookies = true;
---

{analitica && (
  <script
    is:inline
    data-cfasync="false"
    set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
window.gtag = gtag;

// Todo denegado por defecto. Sin wait_for_update: ese parámetro hace esperar
// medio segundo a un update que, en este montaje, o se emite en el mismo bloque
// síncrono (visitante recurrente, más abajo) o no se emite nunca. Solo
// penalizaba al visitante.
//
// Los CUATRO parámetros se declaran, pero al aceptar solo se concede
// analytics_storage. No es un descuido: el banner dice "cookies analíticas" y
// la Política de Cookies no nombra publicidad, así que conceder ad_storage,
// ad_user_data o ad_personalization sería un consentimiento que el visitante
// nunca dio (RGPD art. 4.11: específico e informado). Lo señaló la revisión
// del PR #1. El día que haya campañas, primero se reescriben el banner y la
// política con el inventario real, y solo entonces se conceden los ad_*.
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied'
});

// gtag.js NO se descarga aquí. Son 145 KB comprimidos de Google — casi cinco
// veces el peso de la página entera — y descargarlos antes de que el visitante
// toque el banner haría que "Rechazar" no impidiese la petición. Se inyecta
// solo al aceptar, y una sola vez.
window.ufCargarAnalitica = function () {
  if (window.__ufAnaliticaCargada) return;
  window.__ufAnaliticaCargada = true;
  var s = document.createElement('script');
  s.async = true;
  s.src = 'https://www.googletagmanager.com/gtag/js?id=${ga4Id}';
  document.head.appendChild(s);
  gtag('js', new Date());
  gtag('config', '${ga4Id}', { anonymize_ip: true });
};

// Visitante que ya aceptó en una visita anterior: no se le vuelve a preguntar.
//
// Solo analytics_storage, y aquí con doble motivo: además de lo del bloque de
// arriba, este 'granted' puede ser ANTERIOR a que existiera GA4 en la web —
// el banner lleva vivo desde antes y escribía la decisión aunque no gobernara
// nada. Heredar ese clic como consentimiento publicitario sería atribuirle al
// visitante algo que jamás vio. Se hereda exactamente lo que el aviso de
// entonces decía: analítica.
try {
  if (localStorage.getItem('uf-consent') === 'granted') {
    gtag('consent', 'update', { analytics_storage: 'granted' });
    window.ufCargarAnalitica();
  }
} catch (e) {}
`}
  />
)}

{avisoCookies && (
  <Fragment>
    <div id="uf-cookie-banner" class="uf-cookie" role="dialog" aria-label="Aviso de cookies" hidden>
      <p class="uf-cookie-text">
        Utilizamos cookies analíticas propias y de terceros para mejorar nuestros servicios.
        Puedes aceptarlas o rechazarlas. Más información en nuestra
        <a href={cookiePolicyHref}>Política de Cookies</a>.
      </p>
      <div class="uf-cookie-actions">
        <button id="uf-reject" type="button" class="uf-btn uf-btn-ghost">Rechazar</button>
        <button id="uf-accept" type="button" class="uf-btn uf-btn-primary">Aceptar</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'uf-consent';
        var banner = document.getElementById('uf-cookie-banner');
        if (!banner) return;
        function stored() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        if (!stored()) { banner.hidden = false; }
        function decide(value) {
          try { localStorage.setItem(KEY, value); } catch (e) {}
          banner.hidden = true;
          var concedido = value === 'granted';
          if (window.gtag) {
            // Se emite en los dos sentidos: retirar el consentimiento tiene que
            // revocar de verdad, no solo dejar de conceder (RGPD art. 7.3).
            //
            // SOLO analytics_storage. Los tres ad_* quedan en el 'denied' del
            // default y ahí se quedan: el banner habla de "cookies analíticas"
            // y la Política de Cookies no menciona publicidad, así que no hay
            // consentimiento informado que conceder para eso (lo señaló la
            // revisión del PR #1). Cuando existan campañas: primero banner y
            // política nuevos, después los ad_*.
            window.gtag('consent', 'update', {
              analytics_storage: concedido ? 'granted' : 'denied'
            });
          }
          // La descarga del tag ocurre AQUÍ y no antes. Sin esta línea el
          // consentimiento funciona pero no mide nada: comprobado en navegador
          // — aceptar dejaba 0 scripts de Google y 0 cookies.
          // `ufCargarAnalitica` no existe en una tienda sin ga4Id, de ahí la
          // comprobación.
          if (concedido && window.ufCargarAnalitica) { window.ufCargarAnalitica(); }

          // Y al revocar, se borran las cookies que se escribieron con el
          // consentimiento. gtag deja de usarlas pero NO las borra, así que sin
          // esto la revocación es medio simbólica: el identificador del visitante
          // seguiría en su navegador.
          //
          // Sufijos PROGRESIVOS del hostname, no solo el host exacto: GA escribe
          // en el dominio registrable, así que visitando con el prefijo www. la
          // cookie vive en el dominio pelado con punto delante — y la primera
          // versión de este bloque, que solo probaba el host y '.'+host, la
          // dejaba viva ahí. Lo encontró la revisión del PR #1; el www. no es
          // hipotético: responde 200 sin redirect en las 7 tiendas.
          // (Sin nombres de dominio reales en este comentario: es un script
          // inline, VIAJA EN EL HTML de las 7 sociedades, y el test de
          // aislamiento se puso rojo cuando este texto nombró a una de ellas.)
          if (!concedido) {
            var partes = location.hostname.split('.');
            var dominios = [''];
            for (var i = 0; i < partes.length - 1; i++) {
              dominios.push(partes.slice(i).join('.'));
              dominios.push('.' + partes.slice(i).join('.'));
            }
            document.cookie.split(';').forEach(function (par) {
              var nombre = par.split('=')[0].trim();
              // _ga/_gid/_gat (Analytics) y _gac/_gcl (Ads). Los ad_* nunca se
              // conceden hoy, pero borrar de más es gratis y borrar de menos
              // incumple el art. 7.3.
              if (!/^_(ga|gid|gat|gac|gcl)/.test(nombre)) return;
              dominios.forEach(function (d) {
                document.cookie = nombre + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
              });
            });
          }
        }
        document.getElementById('uf-accept').addEventListener('click', function () { decide('granted'); });
        document.getElementById('uf-reject').addEventListener('click', function () { decide('denied'); });

        // REVOCACIÓN. El art. 7.3 del RGPD exige que retirar el consentimiento
        // sea tan fácil como darlo, y la propia Política de Privacidad promete
        // "retirar el consentimiento en cualquier momento y de manera gratuita".
        // Antes no había ningún mecanismo: una vez decidido, el aviso no volvía
        // a salir nunca. Cualquier elemento con [data-uf-cookie-config] lo reabre.
        document.addEventListener('click', function (ev) {
          var t = ev.target.closest && ev.target.closest('[data-uf-cookie-config]');
          if (!t) return;
          ev.preventDefault();
          banner.hidden = false;
          banner.scrollIntoView({ block: 'nearest' });
        });
      })();
    </script>
  </Fragment>
)}

<style>
  .uf-cookie[hidden] {
    display: none !important;
  }

  .uf-cookie {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 1000;
    max-width: 760px;
    margin: 0 auto;
    background: var(--color-bg);
    border: 1px solid var(--color-border-panel);
    border-radius: var(--radius);
    box-shadow: var(--shadow-float);
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
  }

  .uf-cookie-text {
    flex: 1 1 320px;
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .uf-cookie-text a {
    color: var(--color-cta);
    text-decoration: underline;
  }

  .uf-cookie-actions {
    display: flex;
    gap: 0.6rem;
    margin-left: auto;
  }

  .uf-btn {
    padding: 0.6rem 1.4rem;
    border-radius: var(--radius-xs);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    border: 2px solid var(--color-cta);
    font-family: inherit;
  }

  .uf-btn-primary {
    background: var(--color-cta);
    color: var(--color-on-brand);
  }

  .uf-btn-ghost {
    background: transparent;
    color: var(--color-cta);
  }

  @media (max-width: 520px) {
    .uf-cookie-actions {
      width: 100%;
    }
    .uf-btn {
      flex: 1;
    }
  }
</style>
