---
interface Props {
  phone: string;
  instagram?: string;
  /** 'cinta-de-marca' (plantilla Energía): cinta de claims sobre el header. */
  variant?: string;
}
const { phone, instagram, variant } = Astro.props;

/** Claims de marca, comunes a las 50 tiendas: nada que un franquiciado tenga
 *  que mantener. */
const claims = ['Proteína', 'Creatina', 'Pre-entreno', 'Asesoramiento gratis', 'Las mejores marcas'];
---

{variant === 'cinta-de-marca' && (
  <div class="cinta-marca fx-marquesina" aria-label="Reclamos de la marca">
    {/* WCAG 2.2.2: todo contenido en movimiento automático necesita un control
        de pausa. Este botón es EL control global de la página — pausa también
        la banda de promociones. Sin JavaScript el movimiento sigue, pero
        prefers-reduced-motion lo apaga a nivel de CSS, que es la garantía que
        no depende de nada. */}
    <ul class="fx-marquesina__track">
      {claims.map((c) => (
        <li>{c} <span class="cinta-marca__sep" aria-hidden="true">·</span></li>
      ))}
    </ul>
    <ul class="fx-marquesina__track" aria-hidden="true">
      {claims.map((c) => (
        <li>{c} <span class="cinta-marca__sep">·</span></li>
      ))}
    </ul>
    <button type="button" class="cinta-marca__pausa" id="uf-pausa-marquesinas" aria-pressed="false" aria-label="Pausar el movimiento de la página">
      ⏸
    </button>
  </div>
)}
{variant === 'cinta-de-marca' && (
  <script is:inline>
    (function () {
      var b = document.getElementById('uf-pausa-marquesinas');
      if (!b) return;
      b.addEventListener('click', function () {
        var pausado = document.documentElement.classList.toggle('marquesinas-pausadas');
        b.setAttribute('aria-pressed', String(pausado));
        b.textContent = pausado ? '▶' : '⏸';
        b.setAttribute('aria-label', pausado ? 'Reanudar el movimiento de la página' : 'Pausar el movimiento de la página');
      });
    })();
  </script>
)}
<header class="header" role="banner">
  <nav class="container header-inner" aria-label="Navegación principal">
    <a href="#inicio" class="logo-link" aria-label="USA Fitness - Inicio">
      <img src="/usafitness.svg" alt="USA Fitness logo" class="logo" width="200" height="42" />
    </a>
    <div class="header-actions">
      {instagram && (
        <a href={instagram} target="_blank" rel="noopener noreferrer" class="header-ig" aria-label="Síguenos en Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.62c-3.15 0-3.52.01-4.76.07-.92.04-1.42.2-1.75.33-.44.17-.76.38-1.09.71-.33.33-.54.65-.71 1.09-.13.33-.29.83-.33 1.75-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.04.92.2 1.42.33 1.75.17.44.38.76.71 1.09.33.33.65.54 1.09.71.33.13.83.29 1.75.33 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c.92-.04 1.42-.2 1.75-.33.44-.17.76-.38 1.09-.71.33-.33.54-.65.71-1.09.13-.33.29-.83.33-1.75.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.04-.92-.2-1.42-.33-1.75a2.94 2.94 0 0 0-.71-1.09 2.94 2.94 0 0 0-1.09-.71c-.33-.13-.83-.29-1.75-.33-1.24-.06-1.61-.07-4.76-.07zM12 6.87a5.13 5.13 0 1 0 0 10.26 5.13 5.13 0 0 0 0-10.26zm0 8.46a3.33 3.33 0 1 1 0-6.66 3.33 3.33 0 0 1 0 6.66zm6.54-8.66a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>
        </a>
      )}
      <a href={`tel:${phone}`} class="header-phone btn btn-primary" aria-label={`Llamar al ${phone}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Llámanos
      </a>
    </div>
  </nav>
</header>

<style>
  .header {
    background: var(--color-bg);
    height: 70px;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-header);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo-link {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 14px 0;
  }

  .logo {
    height: 100%;
    width: auto;
    max-width: 200px;
    object-fit: contain;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header-ig {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--color-on-brand);
    background: var(--gradient-instagram);
    transition: transform 0.15s, box-shadow 0.15s;
    flex-shrink: 0;
  }

  .header-ig:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-instagram);
  }

  .header-phone {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .logo {
      max-width: 150px;
    }

    .header-ig {
      width: 36px;
      height: 36px;
    }

    .header-phone {
      padding: 0.4rem 0.8rem;
      font-size: 0.8rem;
    }
  }
</style>
