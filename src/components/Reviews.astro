---
interface Review {
  text: string;
  author: string;
  avatar: string;
  stars: number;
}

/**
 * VARIANTE `dato` — las reseñas como prueba, no como carrusel
 *
 * La cara de siempre son pestañas con JavaScript: tres botones «Reseña de
 * Google» y un panel que se cambia al pulsar. Se queda intacta, porque es lo que
 * sirven las ocho webs vivas.
 *
 * Qué cambia la variante, y por qué:
 *
 *  · **Se leen todas a la vez.** Un carrusel esconde dos tercios de la prueba
 *    social detrás de un clic que casi nadie da, y aquí la prueba es justo lo
 *    que hay que enseñar. Tres citas cortas caben sin esconder nada.
 *  · **Cero JavaScript.** Sin pestañas no hay estado que gestionar.
 *  · **Umbral de TRES.** Con menos, la sección no se pinta: dos reseñas no son
 *    prueba social, son dos personas. Villanueva tiene dos y hoy las enseña.
 *  · **Y la que no llega a tres pide la suya**, pero no aquí: la píldora vive en
 *    «Hoy en tienda», que es la sección que sí ve todo el mundo. Anunciar el
 *    vacío en el sitio donde deberían estar las reseñas sería subrayarlo.
 *
 * SIN `aggregateRating`, como en la clásica: no tenemos la nota media real de
 * Google, solo dos o tres citas curadas, y emitir una media calculada sobre lo
 * que nosotros elegimos sería inventarse una estrella.
 */
import { enlaceResena } from '@/data/resenas';

/** Menos de esto no es prueba social, son dos personas. */
export const MINIMO_RESENAS = 3;

interface Props {
  reviews: Review[];
  placeId?: string;
  googleMapsLink?: string;
  variant?: string;
}

const { reviews, placeId, googleMapsLink, variant } = Astro.props;
const enlace = enlaceResena({ placeId, googleMapsLink });

/**
 * De la más corta a la más larga.
 *
 * No se recorta ninguna —es texto firmado con nombre y apellidos que la tienda
 * republica, la misma regla que `citas.ts`—, pero sí se ordena. Las ocho
 * reseñas de la flota van de 88 a 369 caracteres, y con la de 369 arriba la
 * sección abre con once líneas seguidas de una sola persona. Empezando por la
 * corta, el ojo entra.
 */
const porLongitud = [...reviews].sort((a, b) => a.text.length - b.text.length);
---

{variant === 'dato' ? (
  reviews.length >= MINIMO_RESENAS && (
    <section class="reviews section">
      <div class="container dato-inner">
        <h2 class="dato-titulo">Lo que dicen en Google</h2>

        {/* SIN ESTRELLAS, y no es un olvido. Las ocho reseñas de la flota son
            de cinco estrellas —lógico: las elegimos nosotros—, así que pintar
            cinco glifos idénticos en todas no informa de nada y sugiere una
            distribución que no existe. Encima fallaban el contraste: el amarillo
            de marca da 1,85 sobre blanco y el mínimo son 4,5, medido el 11-sep.
            El dato sigue en `stores.json`; el día que entre una reseña que no
            sea de cinco, esto se vuelve a decidir con ese caso delante. */}
        <ul class="dato-lista">
          {porLongitud.map((r) => (
            <li class="dato-resena">
              <p class="dato-texto">«{r.text}»</p>
              <p class="dato-firma">{r.author}, en Google</p>
            </li>
          ))}
        </ul>

        {enlace && (
          <p class="dato-cierre">
            <a href={enlace.href} target="_blank" rel="noopener noreferrer" class="dato-enlace">{enlace.etiqueta}</a>
          </p>
        )}
      </div>
    </section>
  )
) : (

<section class="reviews section">
  <div class="container">
    <div class="reviews-tabs" role="tablist">
      {reviews.map((_, i) => (
        <button
          role="tab"
          class={`review-tab ${i === 0 ? 'active' : ''}`}
          data-tab={i}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`review-panel-${i}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Reseña de Google
        </button>
      ))}
    </div>

    <div class="reviews-panels">
      {reviews.map((review, i) => (
        <div
          id={`review-panel-${i}`}
          role="tabpanel"
          class={`review-panel ${i === 0 ? 'active' : ''}`}
          data-panel={i}
        >
          <blockquote class="review-text">"{review.text}"</blockquote>
          <div class="review-author">
            {review.avatar ? (
              <img src={review.avatar} alt={review.author} class="review-avatar-img" width="44" height="44" loading="lazy" referrerpolicy="no-referrer" />
            ) : (
              <div class="review-avatar">
                {review.author.charAt(0)}
              </div>
            )}
            <div>
              <p class="review-name">{review.author}</p>
              {/* role="img" + aria-label: los cinco caracteres pasan a ser un
                  solo objeto con un nombre, y el lector de pantalla anuncia
                  "4 de 5 estrellas" en vez de deletrear "estrella negra"
                  cuatro veces (NVDA) o saltárselo entero (VoiceOver). */}
              <p class="stars" role="img" aria-label={`${review.stars} de 5 estrellas`}>{'★'.repeat(review.stars)}{'☆'.repeat(5 - review.stars)}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.review-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const index = (tab as HTMLElement).dataset.tab;
      document.querySelectorAll('.review-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.review-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      document.querySelector(`[data-panel="${index}"]`)?.classList.add('active');
    });
  });
</script>

)}

<style>
  .reviews {
    background: var(--color-bg);
    padding-bottom: 2rem;
  }

  .reviews-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .review-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.25rem;
    border: 2px solid var(--color-border);
    border-radius: 50px;
    background: var(--color-bg);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-light);
    transition: all 0.2s;
    font-family: inherit;
  }

  .review-tab.active {
    background: var(--color-cta);
    color: var(--color-on-brand);
    border-color: var(--color-cta);
  }

  .review-tab:hover:not(.active) {
    border-color: var(--color-cta);
    color: var(--color-cta);
  }

  .review-panel {
    display: none;
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .review-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .review-text {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-light);
    font-style: italic;
    margin-bottom: 1.5rem;
    border: none;
    padding: 0;
  }

  .review-author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .review-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .review-avatar-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .review-name {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.95rem;
  }

  .stars {
    margin-top: 2px;
  }
  /* ————— variante `dato` ————— */

  .dato-inner {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .dato-titulo {
    margin: 0;
    font-size: 0.8rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  .dato-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* Filete de separación, como en «Por qué en tienda» y la FAQ: son una lista
     de voces, no tres tarjetas que floten. */
  .dato-resena {
    border-top: 1px solid var(--color-border);
    padding: 1rem 0;
  }

  .dato-resena:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .dato-texto {
    margin: 0;
    color: var(--color-text);
    line-height: 1.55;
    max-width: 56ch;
  }

  .dato-firma {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .dato-cierre {
    margin: 0;
  }

  .dato-enlace {
    color: var(--color-cta);
    font-weight: var(--font-weight-strong);
    text-decoration: underline;
  }
</style>
