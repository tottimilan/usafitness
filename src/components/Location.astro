---
interface Props {
  subtitle: string;
  googleMapsEmbed: string;
  googleMapsLink: string;
}
const { subtitle, googleMapsEmbed, googleMapsLink } = Astro.props;
---

<section class="location section" id="ubicacion">
  <div class="container location-grid">
    <div class="location-text">
      <h2 class="section-title location-title">Ubicación destacada</h2>
      <p class="location-subtitle">{subtitle}</p>
      <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary location-btn">
        Abrir en Google Maps
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </a>
    </div>
    {/* FACHADA CON CLIC-PARA-CARGAR.
        Antes el <iframe> de Google se incrustaba directamente: instalaba cookies
        y enviaba la IP del visitante a Google antes de que la página terminara
        de pintar, sin aviso ni posibilidad de rechazarlo.

        Ahora no se carga nada de Google hasta que el usuario lo pide. El enlace
        "Abrir en Google Maps" de al lado sigue disponible, así que nadie pierde
        el acceso al mapa: solo deja de imponerse.

        Efecto secundario: se ahorra un iframe de ~700 KB en la carga inicial. */}
    <div class="location-map">
      <div class="map-facade" data-map-src={googleMapsEmbed}>
        <button type="button" class="map-load" data-map-load>
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="map-load-title">Ver el mapa</span>
          <span class="map-load-note">Al cargarlo, Google Maps puede instalar cookies y recibir tu dirección IP.</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Sustituye la fachada por el iframe real solo cuando el usuario lo pide.
    // Si ademas ya habia consentimiento guardado, se carga directamente.
    function cargar(fachada) {
      var src = fachada.getAttribute('data-map-src');
      if (!src) return;
      var f = document.createElement('iframe');
      f.src = src;
      f.width = '100%';
      f.height = '350';
      f.style.cssText = 'border:0;border-radius:var(--radius);display:block';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.title = 'Ubicacion de la tienda en Google Maps';
      f.setAttribute('allowfullscreen', '');
      fachada.replaceWith(f);
    }
    document.addEventListener('click', function (ev) {
      var b = ev.target.closest && ev.target.closest('[data-map-load]');
      if (!b) return;
      var fachada = b.closest('.map-facade');
      if (fachada) cargar(fachada);
    });
    try {
      if (localStorage.getItem('uf-consent') === 'granted') {
        document.querySelectorAll('.map-facade').forEach(cargar);
      }
    } catch (e) {}
  })();
</script>

<style>
  .map-facade {
    border-radius: var(--radius);
    overflow: hidden;
    background:
      linear-gradient(var(--color-bg-alt), var(--color-bg-alt));
    border: 1px solid var(--color-border);
    min-height: 350px;
    display: flex;
  }

  .map-load {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem 1.5rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: inherit;
    color: var(--color-primary);
    text-align: center;
  }

  .map-load:hover { background: var(--color-bg); }

  .map-load-title {
    font-weight: var(--font-weight-strong);
    font-size: 1.05rem;
  }

  .map-load-note {
    font-size: 0.8rem;
    color: var(--color-text-light);
    max-width: 32ch;
    line-height: 1.45;
  }

  .location {
    background: var(--color-bg);
  }

  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .location-title {
    text-align: left;
    margin-bottom: 1rem;
  }

  .location-subtitle {
    color: var(--color-primary-light);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .location-map {
    background: var(--color-bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-panel);
  }

  .location-map iframe {
    width: 100%;
    min-height: 300px;
    display: block;
  }

  @media (max-width: 768px) {
    .location-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .location-title {
      text-align: center;
    }

    .location-text {
      text-align: center;
    }

    .location-btn {
      margin: 0 auto;
    }
  }
</style>
