---
export const prerender = false;

import Base from '@/layouts/Base.astro';
import { stores } from '@/data/stores';
---

<!-- Listado interno para el dominio genérico. `noindex` siempre: no debe
     competir en Google con el dominio de ninguna tienda. -->
<Base title="USAFitness - Tiendas" noindex>
    <div class="index-page">
      <img src="/usafitness.svg" alt="USA Fitness" class="index-logo" width="180" />
      <h1>USAFitness Tiendas</h1>
      <p>Selecciona una tienda:</p>
      <div class="store-links">
        {stores.map((store) => (
          <a href={`/${store.slug}`} class="btn btn-primary store-link">
            {store.name}
          </a>
        ))}
      </div>
    </div>
</Base>

<style>
  .index-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    gap: 1rem;
  }

  .index-logo {
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2rem;
  }

  p {
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }

  .store-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .store-link {
    min-width: 280px;
    justify-content: center;
  }
</style>
