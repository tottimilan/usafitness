---
export const prerender = false;

import Base from '@/layouts/Base.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { porSlug } from '@/data/stores';
import { getLegalDoc, isLegalDoc, LEGAL_DOCS, identificacionProvisional } from '@/data/legal';

const { slug, doc } = Astro.params;
const store = slug ? porSlug.get(slug) : undefined;

if (!store || !isLegalDoc(doc)) {
  return Astro.rewrite('/404');
}

// Legal data is per-store. Only render real policy text when the store has its own
// legal entity configured; otherwise show a clearly-marked "pending" notice (noindex)
// so we never publish another company's data on the wrong store.
const storeCompany = store.company;
const legalReady = !!storeCompany;

const docMeta = LEGAL_DOCS.find((d) => d.slug === doc)!;
const docTitle = docMeta.label;

let bodyHtml = '';
if (legalReady) {
  const legal = getLegalDoc(doc!, storeCompany!, {
    name: store.name,
    location: store.location,
    domain: store.domain,
    slug: store.slug,
  });
  if (!legal) {
    return Astro.redirect(`/${store.slug}`);
  }
  bodyHtml = legal.html;
} else {
  // Sin `company` no se puede publicar un aviso legal completo — y no se
  // inventa: la regla del proyecto es pedir los datos, no rellenarlos.
  // Lo que sí se publica son los datos identificativos del establecimiento
  // que constan y son verificables, diciendo con claridad qué falta. Ver el
  // comentario largo en src/data/legal.ts: es reducción de daño, no
  // cumplimiento del art. 10 LSSI. Sigue en `noindex`.
  bodyHtml = identificacionProvisional(
    {
      name: store.name,
      domain: store.domain,
      streetAddress: store.streetAddress,
      postalCode: store.postalCode,
      addressLocality: store.addressLocality,
      addressRegion: store.addressRegion,
      phoneDisplay: store.phoneDisplay,
      phone: store.phone,
    },
    docTitle
  );
}

const host = Astro.request.headers.get('host')?.split(':')[0] ?? '';
const onOwnDomain = host === store.domain || host === `www.${store.domain}`;
const legalBase = onOwnDomain ? '' : `/${store.slug}`;
const homeHref = onOwnDomain ? '/' : `/${store.slug}`;

const pageTitle = `${docTitle} | ${store.name}`;
const canonicalUrl = `https://${store.domain}/${doc}`;
---

<!-- `noindex` cuando no hay datos legales: un aviso legal sin titular no debe
     estar en Google. La OTRA mitad de la regla —indexar solo en el dominio
     propio de la tienda— la aplica Base para todas las páginas por igual.
     Aquí faltaba, y este documento se publicaba `index, follow` también en el
     host de preview de Railway y en el dominio genérico. -->
<Base
  title={pageTitle}
  description={`${docTitle} de ${store.name}.`}
  canonical={canonicalUrl}
  store={store}
  noindex={!legalReady}
>
    <header class="legal-header">
      <div class="container legal-header-inner">
        <a href={homeHref} class="logo-link" aria-label="Volver al inicio">
          <img src="/usafitness.svg" alt="USA Fitness logo" class="logo" width="200" height="42" />
        </a>
        <a href={homeHref} class="legal-back">&larr; Volver</a>
      </div>
    </header>

    <main class="legal-main">
      <div class="container legal-container">
        <h1 class="legal-title">{docTitle}</h1>
        <p class="legal-domain">{store.name} &mdash; https://{store.domain}</p>
        <article class="legal-content" set:html={bodyHtml} />
      </div>
    </main>

    <Footer name={store.name} slug={store.slug} legalBase={legalBase} />
    {/* Mismo acotado que en la landing: el ga4Id no viaja fuera del dominio
        propio de la tienda. */}
    <CookieConsent
      ga4Id={onOwnDomain || host === 'localhost' || host === '127.0.0.1' ? store.ga4Id : undefined}
      cookiePolicyHref={`${legalBase}/politica-de-cookies`}
    />
</Base>

<style>
  .legal-header {
    background: var(--color-bg);
    height: 70px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .legal-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo-link {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 14px 0;
  }

  .logo {
    height: 100%;
    width: auto;
    max-width: 200px;
    object-fit: contain;
  }

  .legal-back {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-cta);
  }

  .legal-main {
    padding: 3rem 0 4rem;
  }

  .legal-container {
    max-width: 820px;
  }

  .legal-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .legal-domain {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin-bottom: 2.5rem;
  }
</style>
