---
export const prerender = false;

import Landing from '@/layouts/Landing.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import ConversionTracking from '@/components/ConversionTracking.astro';
import { porSlug } from '@/data/stores';
import { getTemplate, resolveSections, tokensToCss } from '@/data/templates';
import { buildPlan } from '@/sections/registry';

const slug = Astro.params.slug;
const store = slug ? porSlug.get(slug) : undefined;

if (!store) {
  // 404 real, no un 302 a la home. El redirect anterior hacía que ninguna URL
  // rota fuera reportable en Search Console y que cualquier ruta inventada
  // acabara devolviendo 200.
  return Astro.rewrite('/404');
}

const host = Astro.request.headers.get('host')?.split(':')[0] ?? '';
const onOwnDomain = host === store.domain || host === `www.${store.domain}`;
const legalBase = onOwnDomain ? '' : `/${store.slug}`;

// La tienda declara su plantilla; si no declara nada, sale la clásica con el
// orden de siempre. Fuera del dominio canónico, ?plantilla= permite previsualizar
// otra sin tocar la configuración (ver Landing.astro).
const preview = !onOwnDomain
  ? (Astro.url.searchParams.get('plantilla') ?? '').replace(/[^0-9a-z-]/gi, '').slice(0, 12)
  : '';
const template = getTemplate(preview || store.template);

// La plantilla propone el orden; la tienda puede ajustarlo con su campo `sections`.
const orden = resolveSections(template, store.sections);
const plan = buildPlan(store, orden);

// El aggregateRating ya no se emite (ver Landing.astro), pero el layout sigue
// recibiendo el recuento por si hiciera falta para otra cosa.
const reviews = store.reviews;
---

<Landing
  name={store.name}
  domain={store.domain}
  title={store.title}
  metaDescription={store.metaDescription}
  location={store.location}
  phone={store.phone}
  phoneDisplay={store.phoneDisplay}
  schedule={store.schedule}
  slug={store.slug}
  streetAddress={store.streetAddress}
  postalCode={store.postalCode}
  addressLocality={store.addressLocality}
  addressRegion={store.addressRegion}
  geo={store.geo}
  reviewCount={reviews.length}
  heroImage={store.heroImage}
  social={store.social}
  googleSiteVerification={store.googleSiteVerification}
  plantilla={template.id}
  plantillaCss={tokensToCss(template)}
>
  <Header phone={store.phone} instagram={store.social?.instagram} />

  {plan.map(({ component: Section, props }) => <Section {...props} />)}

  <Footer name={store.name} slug={store.slug} legalBase={legalBase} />
  <WhatsAppFloat whatsapp={store.whatsapp} name={store.name} />
  <CookieConsent ga4Id={store.ga4Id} cookiePolicyHref={`${legalBase}/politica-de-cookies`} />
  <ConversionTracking />
</Landing>
