---
export const prerender = false;

import Landing from '@/layouts/Landing.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import ConversionTracking from '@/components/ConversionTracking.astro';
import { porSlug } from '@/data/stores';
import { getTemplate, ordenDeSecciones, tokensToCss } from '@/data/templates';
import { fuentesDeLaPagina } from '@/data/presupuesto';
import { buildPlan, tieneDato } from '@/sections/registry';

const slug = Astro.params.slug;
const store = slug ? porSlug.get(slug) : undefined;

if (!store) {
  // 404 real, no un 302 a la home. El redirect anterior hacía que ninguna URL
  // rota fuera reportable en Search Console y que cualquier ruta inventada
  // acabara devolviendo 200.
  return Astro.rewrite('/404');
}

const host = Astro.request.headers.get('host')?.split(':')[0] ?? '';
const onOwnDomain = host === store.domain || host === `www.${store.domain}`;
const legalBase = onOwnDomain ? '' : `/${store.slug}`;

// La tienda declara su plantilla; si no declara nada, sale la clásica con el
// orden de siempre. Fuera del dominio canónico, ?plantilla= permite previsualizar
// otra sin tocar la configuración (ver Landing.astro).
const preview = !onOwnDomain
  ? (Astro.url.searchParams.get('plantilla') ?? '').replace(/[^0-9a-z-]/gi, '').slice(0, 12)
  : '';
const template = getTemplate(preview || store.template);

// La plantilla propone el orden; la tienda lo ajusta de dos formas, y solo dos:
// `sections` (la válvula del operador, que lo reemplaza entero) y `prioridad`
// (la elección del franquiciado, que mueve UN bloque en el hueco que la
// plantilla reserva). Sin ninguna de las dos, el orden de la plantilla tal cual.
const orden = ordenDeSecciones(template, store, (id) => tieneDato(id, store));
const plan = buildPlan(store, orden);
---

<Landing
  store={store}
  plantilla={template.id}
  plantillaCss={tokensToCss(template) + (template.css ?? '')}
  plantillaFonts={fuentesDeLaPagina(template)}
>
  {/* Enlace de salto: primer elemento focusable de la página. Sin esto había
      que atravesar la cabecera entera con el tabulador en cada visita. Solo se
      ve al recibir el foco (ver .salto-contenido en global.css). */}
  <a href="#contenido" class="salto-contenido">Saltar al contenido</a>

  <Header phone={store.phone} instagram={store.social?.instagram} variant={template.periferia?.header} />

  <main id="contenido">
    {plan.map(({ component: Section, props }) => <Section {...props} />)}
  </main>

  <Footer name={store.name} slug={store.slug} legalBase={legalBase} variant={template.periferia?.footer} />
  <WhatsAppFloat
    whatsapp={store.whatsapp}
    name={store.name}
    variant={template.periferia?.contacto}
    phone={store.phone}
    googleMapsLink={store.googleMapsLink}
  />
  {/* ga4Id solo en el dominio propio (más localhost, para poder probar el
      banner en desarrollo): en el host de preview mediría sesiones ajenas
      dentro de la propiedad GA4 del franquiciado. Mismo acotado que ya
      tiene el token de Search Console en Base.astro. */}
  <CookieConsent
    ga4Id={onOwnDomain || host === 'localhost' || host === '127.0.0.1' ? store.ga4Id : undefined}
    cookiePolicyHref={`${legalBase}/politica-de-cookies`}
  />
  <ConversionTracking />
</Landing>
