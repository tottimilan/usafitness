---
/**
 * LANDING — la portada de una tienda
 *
 * Solo aporta dos cosas sobre `Base.astro`: los datos estructurados de
 * Schema.org y el `<main>`. Todo el `<head>` vive en Base.
 *
 * Recibe la tienda ENTERA y no 20 props sueltas. Antes `[...slug].astro`
 * copiaba campo a campo (`name={store.name}`, `domain={store.domain}`…), y ahí
 * cabe pasar un campo por otro sin que nada avise. Ahora hay un tipo real
 * derivado del esquema de `stores.json`, así que el compilador lo impide.
 */
import Base from '@/layouts/Base.astro';
import { parseHorario } from '@/data/horario';
import type { Tienda } from '@/data/stores';

interface Props {
  store: Tienda;
  /** Id de la plantilla activa y su CSS de tokens (ver `data/templates.ts`). */
  plantilla?: string;
  plantillaCss?: string;
}

const { store, plantilla = '', plantillaCss = '' } = Astro.props;

const pageTitle = `${store.name} | Nutrición Deportiva en ${store.location}`;
const canonicalUrl = `https://${store.domain}/`;
const ogImageUrl = `https://${store.domain}${store.heroImage}`;
const sameAs = [
  store.social?.instagram,
  store.social?.facebook,
  store.social?.tiktok,
  store.social?.youtube,
].filter(Boolean) as string[];

const openingHours = parseHorario(store.schedule);

const structuredData: Record<string, any> = {
  '@context': 'https://schema.org',
  // Store es subtipo de LocalBusiness: conserva todas sus propiedades y le dice
  // a Google que esto es un comercio con local, no una empresa cualquiera.
  '@type': 'Store',
  '@id': `${canonicalUrl}#store`,
  name: store.name,
  description: store.metaDescription,
  url: canonicalUrl,
  telephone: store.phone,
  image: ogImageUrl,
  logo: `https://${store.domain}/usafitness.svg`,
  ...(sameAs.length > 0 && { sameAs }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: store.streetAddress,
    // addressLocality es el MUNICIPIO, no el texto de marketing de `location`
    // (que puede ser una frase como "el noroeste de Madrid"). addressRegion es
    // la provincia.
    addressLocality: store.addressLocality,
    postalCode: store.postalCode,
    addressRegion: store.addressRegion,
    addressCountry: 'ES',
  },
  ...(openingHours.length > 0 && { openingHoursSpecification: openingHours }),
  // SIN aggregateRating, deliberadamente. Google: "If the entity that's being
  // reviewed controls the reviews about itself, their pages that use
  // LocalBusiness or any other type of Organization structured data are
  // ineligible for star review feature". Las reseñas viven en stores.json, es
  // decir las controla el propio negocio: el marcado no produce estrellas y sí
  // expone a una acción manual por marcado engañoso, multiplicada por dominio.
  // Las estrellas salen de la ficha de Google Business, en el pack local.
  // Tampoco vale traerlas de la API de Google: "Don't aggregate reviews or
  // ratings from other websites".
};

if (store.geo) {
  structuredData.geo = {
    '@type': 'GeoCoordinates',
    latitude: store.geo.lat,
    longitude: store.geo.lng,
  };
  structuredData.hasMap = `https://www.google.com/maps?q=${store.geo.lat},${store.geo.lng}`;
}
---

<Base
  title={pageTitle}
  description={store.metaDescription}
  canonical={canonicalUrl}
  store={store}
  plantilla={plantilla}
  plantillaCss={plantillaCss}
  og={{
    type: 'business.business',
    image: ogImageUrl,
    imageAlt: `${store.name} - Tienda de nutrición deportiva`,
    siteName: store.name,
  }}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />

  <main>
    <slot />
  </main>
</Base>
