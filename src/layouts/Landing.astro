---
interface Props {
  name: string;
  domain: string;
  title: string;
  metaDescription: string;
  location: string;
  phone: string;
  phoneDisplay: string;
  schedule: string;
  slug: string;
  streetAddress?: string;
  postalCode?: string;
  geo?: { lat: number; lng: number };
  reviewCount?: number;
  avgRating?: number;
  heroImage?: string;
  social?: { instagram?: string; facebook?: string; tiktok?: string; youtube?: string };
  googleSiteVerification?: string;
}

const {
  name, domain, title, metaDescription, location,
  phone, phoneDisplay, schedule, slug,
  streetAddress = '', postalCode = '',
  geo, reviewCount = 3, avgRating = 5,
  heroImage = `/photos/${slug}/hero.jpg`,
  social = {},
  googleSiteVerification = ''
} = Astro.props;

const pageTitle = `${name} | Nutrición Deportiva en ${location}`;
const canonicalUrl = `https://${domain}/`;
const ogImage = heroImage;
const ogImageUrl = `https://${domain}${ogImage}`;
const logoUrl = `https://${domain}/usafitness.svg`;
const sameAs = [social.instagram, social.facebook, social.tiktok, social.youtube].filter(Boolean) as string[];

// Only the store's own canonical domain should be indexable. Any other host
// (Railway preview, the generic domain serving /slug, etc.) is set to noindex
// so it never competes with or mixes into the store's own domain in Google.
const reqHost = Astro.request.headers.get('host')?.split(':')[0] ?? '';
const isCanonicalHost = reqHost === domain || reqHost === `www.${domain}`;
const robotsContent = isCanonicalHost ? 'index, follow, max-image-preview:large' : 'noindex, follow';

function parseScheduleToSchema(scheduleText: string) {
  const MON_FRI = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
  const MON_SAT = [...MON_FRI, "Saturday"];
  const MON_SUN = [...MON_SAT, "Sunday"];

  const specs: any[] = [];
  const lines = scheduleText.split('\n');
  for (const line of lines) {
    const lower = line.toLowerCase();
    const timeMatch = line.match(/(\d{1,2}:\d{2})\s*[a–-]\s*(\d{1,2}:\d{2})/);
    if (!timeMatch) continue;

    // Match day ranges first to avoid duplicating single days (e.g. "lunes a domingo").
    let dayOfWeek: string[] | null = null;
    if (lower.includes('lunes a domingo')) {
      dayOfWeek = MON_SUN;
    } else if (lower.includes('lunes a sábado')) {
      dayOfWeek = MON_SAT;
    } else if (lower.includes('lunes a viernes')) {
      dayOfWeek = MON_FRI;
    } else if (lower.includes('domingo')) {
      dayOfWeek = ["Sunday"];
    } else if (lower.includes('sábado')) {
      dayOfWeek = ["Saturday"];
    }

    if (dayOfWeek) {
      specs.push({
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": dayOfWeek,
        "opens": timeMatch[1],
        "closes": timeMatch[2]
      });
    }
  }
  return specs.length > 0 ? specs : undefined;
}

const openingHours = parseScheduleToSchema(schedule);

const structuredData: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": name,
  "description": metaDescription,
  "url": canonicalUrl,
  "telephone": phone,
  "image": ogImageUrl,
  "logo": logoUrl,
  ...(sameAs.length > 0 && { "sameAs": sameAs }),
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    ...(streetAddress && { "streetAddress": streetAddress }),
    "addressLocality": location,
    ...(postalCode && { "postalCode": postalCode }),
    "addressRegion": "España",
    "addressCountry": "ES"
  },
  ...(openingHours && { "openingHoursSpecification": openingHours }),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": String(avgRating),
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": String(reviewCount)
  }
};

if (geo) {
  structuredData["geo"] = {
    "@type": "GeoCoordinates",
    "latitude": geo.lat,
    "longitude": geo.lng
  };
  structuredData["hasMap"] = `https://www.google.com/maps?q=${geo.lat},${geo.lng}`;
}

import '@/styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#1B3A6B" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="business.business" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${name} - Tienda de nutrición deportiva`} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon-96.png" />
    <title>{pageTitle}</title>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
