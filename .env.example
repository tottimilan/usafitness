# MASTERMIND 2.0 — Environment variables template
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. Never commit real tokens.
# Required scopes for the GitHub PAT: repo (full), read:org, read:user.
# Generate at: https://github.com/settings/tokens

# --- Cursor / Claude MCPs ---

# GitHub MCP — https://github.com/modelcontextprotocol/servers/tree/main/src/github
GITHUB_PERSONAL_ACCESS_TOKEN=

# Context7 MCP — https://context7.com/ (optional; free tier works without key)
# CONTEXT7_API_KEY=

# --- Reserved for System 2 ---

# Task Master AI — https://github.com/eyaltoledano/claude-task-master
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# OPENAI_API_KEY=

# --- Application secrets (per project — fill when stack is chosen) ---

# Example placeholders. Remove or adapt when the stack is confirmed.
# DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
