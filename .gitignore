# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
.secrets/

# --- Node / JS ---
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build output ---
# Anclados a la raiz con "/" a proposito. Sin la barra, `build/` significa
# "cualquier carpeta llamada build a cualquier profundidad", y eso se tragaba
# `src/build/` — codigo fuente. El fichero existia en local, los tests pasaban
# en local, y el CI fallaba con "Cannot find module" porque nunca se subio.
# Un `git status` limpio no demuestra que el arbol este completo.
/dist/
/build/
/out/
/.next/
/.nuxt/
/.turbo/
.cache/
coverage/
.vercel/
.netlify/
.wrangler/

# --- TypeScript ---
*.tsbuildinfo

# --- Python (just in case) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- IDE / Editor ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- OS ---
$RECYCLE.BIN/
System Volume Information/

# --- Logs ---
logs/
*.log

# --- Cursor / Claude local state ---
.cursor/.local/
.cursor/cache/
.claude/cache/
.claude/.local/

# --- MCP local state (keep config, ignore runtime) ---
claude-side/.runtime/
claude-side/*.local.json

# --- MASTERMIND runtime (dispatch log + ephemeral observability; never committed) ---
.mastermind/runtime/

# --- Test artifacts ---
playwright-report/
test-results/
*.lcov

# --- Misc ---
.tmp/
.temp/
tmp/
temp/

# --- Backups created by scripts/sync-from-template; safe to delete after review. ---
.mastermind-backups/

# --- Local research notes (out of git, used to evaluate ecosystem tools). ---
# Anchored to repo root on purpose: project research under docs/ (e.g.
# docs/architecture/research/, written by the research-first skill) IS versioned.
/research/

# --- Template-author meta-work (kept local, never committed). See .template-meta/README.md. ---
.template-meta/

# --- Project-specific (Astro / this repo) ---
.astro/
*.code-workspace

# --- Originales de marca (pesados; el cliente los custodia) ---
docs/brand/fuentes/*.pdf
docs/brand/fuentes/*.ai
docs/brand/fuentes/*Banner*

# Ficheros de trabajo de una sesion (salida cruda de workflows, borradores)
.plan-*.md
.gate-*.md
